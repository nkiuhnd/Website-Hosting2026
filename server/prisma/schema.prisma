generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev_v2.db"
}

model User {
  id                  String     @id @default(uuid())
  username            String     @unique
  password            String
  phone               String?    @unique
  recoveryCodeHash    String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  role                String     @default("USER")
  status              String     @default("ACTIVE")
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastActiveAt        DateTime?
  province            String?
  city                String?
  school              String?
  createdAt           DateTime   @default(now())
  loginLogs           LoginLog[]
  messages            Message[]
  projects            Project[]
  likes               Like[]
  comments            Comment[]
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  ip        String
  userAgent String?
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                 String           @id @default(uuid())
  name               String
  description        String?
  storagePath        String
  entryFile          String
  size               Int              @default(0)
  visitCount         Int              @default(0)
  status             String           @default("ACTIVE")
  showPlatformFooter Boolean          @default(true)
  userId             String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions           ProjectVersion[]
  visitLogs          VisitLog[]
  likes              Like[]
  comments           Comment[]
  isPublic           Boolean          @default(false)

  @@unique([userId, name])
}

model Message {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String
  read      Boolean  @default(false)
  type      String   @default("system")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectVersion {
  id          Int      @id @default(autoincrement())
  projectId   String
  path        String
  version     Int
  description String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model VisitLog {
  id        Int      @id @default(autoincrement())
  projectId String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Report {
  id        Int      @id @default(autoincrement())
  type      String
  content   String
  targetUrl String
  projectId String?
  ip        String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
